# Local development template. Never place real credentials in this file.
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/medibridge
APP_BASE_URL=http://localhost:3000
VITE_APP_ID=medibridge-local
JWT_SECRET=replace-with-a-long-random-local-secret
OAUTH_SERVER_URL=https://oauth.example.invalid
VITE_OAUTH_PORTAL_URL=https://oauth.example.invalid
OWNER_OPEN_ID=replace-me
FORGE_MAPS_PROXY_BASE_URL=https://forge.example.invalid/v1/maps/proxy/
FORGE_MAPS_PROXY_API_KEY=replace-me
LLM_API_URL=https://llm.example.invalid
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_EMBEDDING_MODEL=text-embedding-3-small
PAYMENT_PROVIDER=mock
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
PAYPAL_WEBHOOK_ID=replace-me
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_CHECKOUT_BASE_URL=https://checkout.stripe.com
RESEND_API_KEY=replace-me
RESEND_FROM=Medibridge <no-reply@example.invalid>
MAIL_FROM=Medibridge <no-reply@example.invalid>
LOCAL_UPLOAD_DIR=data/uploads
